{
  "name": "tech-ascension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run --config vitest.config.ts",
    "smoke:play": "vitest run --config vitest.smoke.config.ts",
    "play:agent": "node scripts/play-agent.mjs",
    "pace": "node scripts/pace.mjs",
    "designs:check": "node scripts/designs-check.mjs",
    "bench:studio": "vitest bench --run --config vitest.config.ts --reporter=verbose --silent=false src/game/studio",
    "preview": "vite preview",
    "build:pages": "tsc -b && vite build --base=/tech-ascension/",
    "preview:pages": "npm run build:pages && vite preview --base=/tech-ascension/ --host 127.0.0.1 --port 43124 --strictPort",
    "generate:emojis": "node scripts/generate-emoji-manifest.mjs",
    "pull:sources": "node scripts/generate-emoji-manifest.mjs"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "developer-icons": "^7.1.0",
    "dexie": "^4.4.6",
    "lucide-react": "^0.575.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tone": "^15.1.22",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
