{
  "name": "tech-ascension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run --config vitest.config.ts",
    "smoke:play": "vitest run --config vitest.smoke.config.ts",
    "play:agent": "node scripts/play-agent.mjs",
    "pace": "node scripts/pace.mjs",
    "check:mobile": "node scripts/mobile-check.mjs",
    "preview": "vite preview",
    "build:pages": "tsc -b && vite build --base=/tech-ascension/",
    "preview:pages": "npm run build:pages && vite preview --base=/tech-ascension/ --host 127.0.0.1 --port 43124 --strictPort",
    "generate:emojis": "node scripts/generate-emoji-manifest.mjs",
    "pull:sources": "node scripts/generate-emoji-manifest.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "developer-icons": "^7.1.0",
    "dexie": "^4.4.6",
    "flag-icons": "^7.5.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "tone": "^15.1.22",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "agent-browser": "0.38.2",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
